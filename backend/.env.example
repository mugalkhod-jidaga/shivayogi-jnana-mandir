# ==========================================
# BACKEND SECRETS (NEVER EXPOSE TO FRONTEND)
# ==========================================

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (required for documents module — Step 3)
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=

# Express App Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Rate limiting overrides
RATE_LIMIT_DEFAULT_MAX=60
RATE_LIMIT_LOGIN_MAX=5

# Bootstrap script only (npm run bootstrap) — remove after first run
BOOTSTRAP_TENANT_ID=1
BOOTSTRAP_ADMIN_PHONE=+91XXXXXXXXXX
BOOTSTRAP_ADMIN_PASSWORD=change-me-temp-password
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=User
